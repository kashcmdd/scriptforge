# --- Required ---
# JWT signing secret for sessions. Generate one:
#   openssl rand -hex 32
# The app refuses to start without it (lib/auth.ts).
AUTH_SECRET=

# --- Optional ---
# Comma-separated emails allowed to upload scripts at /scripts/upload.
ADMIN_EMAILS=admin@example.com

# Scheme+host used to build links in verification/reset emails.
APP_URL=http://localhost:3000

# SQLite database file path. Overridable so a second cohort (e.g. e2e tests)
# can run against its own database.
DATABASE_PATH=data.sqlite

# Resend API key for real email delivery. If unset, emails only log to the
# console (lib/mail.ts) — fine for local dev.
RESEND_API_KEY=
MAIL_FROM=ScriptForge <noreply@yourdomain.com>

# Sentry DSN — wired into lib/logger.ts, leave empty until you have one.
# SENTRY_DSN=